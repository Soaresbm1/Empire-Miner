{
  "name": "empire-miner",
  "version": "0.1.0",
  "private": true,
  "description": "Empire Miner — jeu de minage, progression et automatisation (2D vue de dessus 3/4).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "build:artifact": "tsc --noEmit && vite build --mode artifact",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/playthrough.mjs",
    "balance": "VITE_BALANCE_REPORT=1 vitest run tests/balance-report.test.ts -u"
  },
  "devDependencies": {
    "aedes": "^1.2.0",
    "aedes-server-factory": "^0.2.1",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2",
    "ws": "^8.22.0"
  }
}
